# AWS Configuration
aws_region  = "us-east-1"
aws_profile = "default"  # Your AWS SSO profile name

# Project Configuration
project_name = "youtube-uploader"

# S3 Bucket (must be globally unique)
s3_bucket_name = "your-unique-bucket-name-youtube-uploader"

# DynamoDB Table
dynamodb_table_name = "youtube-uploader-state"

# User IDs (list of tenant identifiers)
user_ids = ["default"]

# S3 Intelligent-Tiering & Archiving
# Intelligent-Tiering is ALWAYS enabled (automatically optimizes costs)
# Objects transition to Intelligent-Tiering immediately (day 0)
# Optional: Enable Deep Archive for long-term cold storage
enable_deep_archive = false  # Set to true to enable Deep Archive after X days
deep_archive_days   = 180    # Move to Deep Archive after 180 days (if enabled)

# ECR Image URIs (update after building Docker images)
# ecr_image_uris = {
#   video_uploader = "123456789012.dkr.ecr.us-east-1.amazonaws.com/youtube-uploader-video-uploader:latest"
# }

# Additional Tags
tags = {
  Environment = "production"
  Owner       = "your-name"
}
